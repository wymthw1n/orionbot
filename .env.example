# ==============================================================
# Orion Bot - Configuration File (.env)
# https://github.com/wymthw1n/orionbot
# ==============================================================

# Telegram Bot Token obtained from @BotFather on Telegram (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Telegram User IDs separated by commas (Required)
# Only users with these IDs can upload/download files or execute commands.
# To find your Telegram User ID, message @userinfobot or send /id to this bot.
ALLOWED_USERS=123456789,987654321

# Directory where received files will be automatically stored
# Can be relative to project root or an absolute path on your VPS
DOWNLOAD_DIR=downloads

# Maximum file size to download/send in megabytes (Telegram default API limit: 20MB download, 50MB send)
# If using a local Telegram Bot API Server, set this up to 2000 (2GB).
MAX_FILE_SIZE_MB=50

# Optional custom Telegram Bot API Server (leave empty if using official api.telegram.org)
# Set to http://127.0.0.1:8081 if running local server for large file transfers (up to 2GB)
BOT_API_SERVER=
BOT_API_IS_LOCAL=false

# Telegram API credentials from https://my.telegram.org (required only if deploying local Telegram Bot API Server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

